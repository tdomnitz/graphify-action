#!/usr/bin/env bash
{
  printf 'args:'; printf ' [%s]' "$@"; printf '\n'
  if [ -z "${GEMINI_API_KEY+x}" ]; then
    printf 'GEMINI_API_KEY=<unset>\n'
  else
    printf 'GEMINI_API_KEY=<set:%s>\n' "$GEMINI_API_KEY"
  fi
} >> "$GRAPHIFY_STUB_LOG"
if [ -n "${GRAPHIFY_STUB_TOUCH:-}" ]; then
  mkdir -p "$(dirname "$GRAPHIFY_STUB_TOUCH")"
  touch "$GRAPHIFY_STUB_TOUCH"
fi
exit "${GRAPHIFY_STUB_EXIT:-0}"
